-- R__seed_products.sql.example
--
-- PLANTILLA de productos de la tienda interna. Este archivo SÍ se versiona,
-- con datos de ejemplo inventados. Para usarlo:
--   1. Cópialo como R__seed_products.sql (mismo directorio, sin ".example").
--   2. Llénalo con los productos y precios reales del hotel.
--   3. R__seed_products.sql queda fuera de git automáticamente (ver .gitignore).
--
-- Es una migración REPETIBLE de Flyway (prefijo R__): no ocupa número de
-- versión, así que puede crearse en cualquier momento sin chocar con las
-- migraciones versionadas (V1, V2, ...). Flyway la vuelve a ejecutar cada vez
-- que su contenido cambia, por eso cada inserción debe ser idempotente.

INSERT INTO product (name, price, stock)
SELECT 'Producto de ejemplo 1', 20000, 100
WHERE NOT EXISTS (SELECT 1 FROM product WHERE name = 'Producto de ejemplo 1');

INSERT INTO product (name, price, stock)
SELECT 'Producto de ejemplo 2', 10000, 100
WHERE NOT EXISTS (SELECT 1 FROM product WHERE name = 'Producto de ejemplo 2');
