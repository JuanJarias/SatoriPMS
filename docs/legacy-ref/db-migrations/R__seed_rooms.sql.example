-- R__seed_rooms.sql.example
--
-- PLANTILLA de habitaciones. Este archivo SÍ se versiona, con datos de
-- ejemplo inventados. Para usarlo:
--   1. Cópialo como R__seed_rooms.sql (mismo directorio, sin ".example").
--   2. Llénalo con las habitaciones reales de TU hotel.
--   3. R__seed_rooms.sql queda fuera de git automáticamente (ver .gitignore),
--      así el repositorio no expone nombres, precios ni capacidades reales.
--   4. Arranca el contenedor `api` (o `mvn flyway:migrate`).
--
-- Es una migración REPETIBLE de Flyway (prefijo R__): no ocupa número de
-- versión, así que puede crearse en cualquier momento sin chocar con las
-- migraciones versionadas. Flyway la vuelve a ejecutar cuando su contenido
-- cambia; "ON CONFLICT (number) DO NOTHING" evita duplicar habitaciones.
-- Si el archivo real no existe, la tabla room queda vacía y nada se rompe.

INSERT INTO room (number, name, type, base_adults_capacity, max_adults_capacity, children_capacity, allows_pets, price_per_night, extra_guest_price) VALUES
('101', 'Habitación de referencia 101', 'ESTANDAR', 2, 3, 1, TRUE,  120000, 20000),
('102', 'Habitación de referencia 102', 'ESTANDAR', 2, 3, 1, TRUE,  120000, 20000),
('103', 'Habitación de referencia 103', 'ESTANDAR', 2, 3, 1, FALSE, 120000, 20000),
('201', 'Habitación de referencia 201', 'DOBLE',    2, 4, 2, TRUE,  160000, 25000),
('202', 'Habitación de referencia 202', 'DOBLE',    2, 4, 2, TRUE,  160000, 25000),
('203', 'Habitación de referencia 203', 'DOBLE',    2, 4, 2, FALSE, 160000, 25000),
('301', 'Habitación de referencia 301', 'SUITE',    4, 6, 2, TRUE,  220000, 30000),
('302', 'Habitación de referencia 302', 'SUITE',    4, 6, 2, TRUE,  220000, 30000),
('303', 'Habitación de referencia 303', 'SUITE',    4, 6, 2, TRUE,  250000, 30000)
ON CONFLICT (number) DO NOTHING;
