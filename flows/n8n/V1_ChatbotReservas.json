    {
      "parameters": {
        "jsCode": "const J = $input.first().json;\nconst wa_id = J.wa_id;\nconst sender_name = J.sender_name || 'Huésped';\nconst text = String(J.message_text || '').trim();\nconst draft = (J.session && J.session.reservation_draft) || {};\nconst parseDate = (s) => { s = String(s || '').trim(); const m = s.match(/^(\\d{4})-(\\d{1,2})-(\\d{1,2})$/); if (!m) return null; const iso = m[1] + '-' + m[2].padStart(2,'0') + '-' + m[3].padStart(2,'0'); return isNaN(new Date(iso + 'T00:00:00Z')) ? null : iso; };\nconst f = parseDate(text);\nif (!f) return [{ json: { wa_id, sender_name, response_text: '⚠️ No reconocí la fecha. Usa el formato AAAA-MM-DD (Ejemplo: 2026-10-15)', session: { state: 'reserva', step: 'checkout', agent_active: false, wa_id, sender_name, reservation_draft: draft } } }];\nif (draft.checkIn && f <= draft.checkIn) return [{ json: { wa_id, sender_name, response_text: '⚠️ La fecha de salida debe ser posterior a la de llegada (*' + draft.checkIn + '*). ¿Cuál es tu fecha de salida?', session: { state: 'reserva', step: 'checkout', agent_active: false, wa_id, sender_name, reservation_draft: draft } } }];\nconst nd = Object.assign({}, draft, { checkOut: f });\nreturn [{ json: { wa_id, sender_name, response_text: '✅ Salida: *' + f + '*\\n\\n🔎 Estoy consultando las habitaciones disponibles del *' + (draft.checkIn || '?') + '* al *' + f + '*...\\n\\n_(Selección de habitación disponible próximamente.)_', session: { state: 'reserva', step: 'seleccion_habitacion', agent_active: false, wa_id, sender_name, reservation_draft: nd } } }];"
      },
