    {
      "parameters": {
        "jsCode": "const J = $input.first().json;\nconst wa_id = J.wa_id;\nconst sender_name = J.sender_name || 'Huésped';\nconst text = String(J.message_text || '').trim();\nconst hoyCO = new Date(Date.now() - 5 * 3600 * 1000).toISOString().slice(0, 10);\nconst parseDate = (s) => { s = String(s || '').trim(); const m = s.match(/^(\\d{4})-(\\d{1,2})-(\\d{1,2})$/); if (!m) return null; const iso = m[1] + '-' + m[2].padStart(2,'0') + '-' + m[3].padStart(2,'0'); return isNaN(new Date(iso + 'T00:00:00Z')) ? null : iso; };\nconst draft = (J.session && J.session.reservation_draft) || {};\nconst f = parseDate(text);\nif (!f) return [{ json: { wa_id, sender_name, response_text: '⚠️ No reconocí la fecha. Usa el formato AAAA-MM-DD (Ejemplo: 2026-10-12)', session: { state: 'reserva', step: 'checkin', agent_active: false, wa_id, sender_name, reservation_draft: draft } } }];\nif (f < hoyCO) return [{ json: { wa_id, sender_name, response_text: '⚠️ La fecha de llegada no puede estar en el pasado. ¿Cuál es tu fecha de llegada?', session: { state: 'reserva', step: 'checkin', agent_active: false, wa_id, sender_name, reservation_draft: draft } } }];\nreturn [{ json: { wa_id, sender_name, response_text: '✅ Llegada: *' + f + '*\\n\\n¿Cuál es la fecha de *salida*?\\nFormato: AAAA-MM-DD', session: { state: 'reserva', step: 'checkout', agent_active: false, wa_id, sender_name, reservation_draft: { checkIn: f } } } }];"
      },
