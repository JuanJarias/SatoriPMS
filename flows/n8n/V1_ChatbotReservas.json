      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst value = body && body.entry && body.entry[0] && body.entry[0].changes && body.entry[0].changes[0] && body.entry[0].changes[0].value;\nconst message = value && value.messages && value.messages[0];\nif (!message) return [{ json: { skip: true } }];\nconst contact = value.contacts && value.contacts[0];\nlet text = '[no-texto]';\nif (message.type === 'text') text = ((message.text && message.text.body) || '').trim();\nelse if (message.type === 'interactive') text = String((message.interactive && message.interactive.button_reply && message.interactive.button_reply.id) || (message.interactive && message.interactive.list_reply && message.interactive.list_reply.id) || (message.interactive && message.interactive.button_reply && message.interactive.button_reply.title) || '').trim();\nelse if (message.type === 'button') text = ((message.button && message.button.text) || '').trim();\nreturn [{ json: { skip: false, wa_id: message.from, message_type: message.type, message_text: text, message_id: message.id, sender_name: (contact && contact.profile && contact.profile.name) || 'Huésped' } }];"
      },
