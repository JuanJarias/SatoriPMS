# ═══════════════════════════════════════════════════════
# SatoriPMS — Variables de entorno
# Copia este archivo como .env y completa los valores
# NUNCA subas el .env al repositorio (está en .gitignore)
# ═══════════════════════════════════════════════════════

# ── Base de datos ────────────────────────────────────────
DATABASE_URL=postgresql://satori:satori_dev@localhost:5432/satoripms
POSTGRES_USER=satori
POSTGRES_PASSWORD=satori_dev
POSTGRES_DB=satoripms

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Backend ──────────────────────────────────────────────
PORT=3000
JWT_SECRET=cambia_esto_por_un_secreto_seguro_de_al_menos_32_caracteres
JWT_EXPIRES_IN=8h
NODE_ENV=development

# ── WhatsApp / Meta ──────────────────────────────────────
WHATSAPP_TOKEN=tu_token_de_la_cloud_api_de_meta
WHATSAPP_PHONE_ID=tu_phone_number_id
WHATSAPP_VERIFY_TOKEN=token_de_verificacion_del_webhook
META_APP_SECRET=tu_app_secret_de_meta

# ── Pasarela de pago ─────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=tu_access_token_de_mercadopago
MERCADOPAGO_WEBHOOK_SECRET=tu_webhook_secret

# ── n8n ──────────────────────────────────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=cambia_esta_password
N8N_WEBHOOK_URL=https://tu-ngrok-o-dominio.com

# ── Frontend ──────────────────────────────────────────────
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000
