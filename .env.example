# ═══════════════════════════════════════════════════════
# SatoriPMS — Variables de entorno
# Copia este archivo como .env y completa los valores
# NUNCA subas el .env al repositorio (está en .gitignore)
# ═══════════════════════════════════════════════════════

# ── Base de datos (PostgreSQL 16: reservas, candados 15m, sesiones V10) ──
DATABASE_URL=postgresql+psycopg://satori:satori_dev@localhost:5432/satoripms
POSTGRES_USER=satori
POSTGRES_PASSWORD=satori_dev
POSTGRES_DB=satoripms

# ── Backend (FastAPI) ────────────────────────────────────
ENVIRONMENT=development
PORT=8080
# Firma de los tokens del personal del hotel (mínimo 32 caracteres). Genérelo con: openssl rand -hex 32
JWT_SECRET=cambia_esto_por_un_secreto_seguro_de_al_menos_32_caracteres
# Duración de la sesión del personal en minutos (480 = 8 horas)
JWT_EXPIRES_MINUTES=480
# Llave que n8n envía a la API en el encabezado X-Service-Key. Genérela con: openssl rand -hex 32
# (la API también la acepta con el nombre N8N_INTERNAL_API_KEY)
SATORI_SERVICE_KEY=cambia_esta_llave_de_servicio

# ── WhatsApp / Meta ──────────────────────────────────────
META_APP_ID=tu_app_id_de_meta
META_APP_SECRET=tu_app_secret_de_meta

WHATSAPP_TEST_PHONE=tu_numero_de_telefono_de_prueba
WHATSAPP_TOKEN=tu_token_de_la_cloud_api_de_meta
WHATSAPP_PHONE_ID=tu_phone_number_id
WHATSAPP_ACCOUNT_ID=tu_account_id_de_meta
WHATSAPP_VERIFY_TOKEN=tu_webhook_verify_token_de_meta
WHATSAPP_GRAPH_VERSION=v25.0

# ── Interpretación asistida ──────────────────────────────
GEMINI_API_KEY=tu_api_key_de_gemini

# ── Pasarela de pago de la API (puerto abstracto: sandbox | wompi) ──
PAYMENT_PROVIDER=sandbox
PAYMENT_WEBHOOK_SECRET=tu_secreto_para_firma_hmac_sha256
WOMPI_ENVIRONMENT=sandbox
# Aviso a n8n cuando un bloqueo temporal expira (opcional)
N8N_EXPIRED_WEBHOOK_URL=

# ── Google Places y reseñas ──────────────────────────────
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=ChIJQRr4FV2zOY4RvqM_8_EfzsY
GOOGLE_REVIEWS_URL=https://www.google.com/travel/hotels/entity/CgsIvsf-mZ_-h-fGARAB/reviews

# ── Observabilidad y respaldos (opcional en dev; recomendado en prod) ──
SENTRY_DSN=
BACKUP_ENCRYPTION_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── Wompi (cobro de reservas del chatbot V9) ─────────────
# Llaves en Wompi > Desarrolladores > Programación. NUNCA las subas al repositorio.
WOMPI_ENABLED=true
WOMPI_API_URL=https://production.wompi.co/v1
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/l/
WOMPI_PUBLIC_KEY=pub_prod_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_PRIVATE_KEY=prv_prod_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_EVENTS_SECRET=prod_events_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=prod_integrity_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_LINK_EXPIRATION_HOURS=24
# Opcional: página a la que vuelve el huésped tras pagar
WOMPI_REDIRECT_URL=

# ── n8n ──────────────────────────────────────────────────
# Incluye "n8n" para levantar el servicio; déjalo vacío para omitirlo.
COMPOSE_PROFILES=n8n
N8N_BASIC_AUTH_USER=SatoriPMS
N8N_BASIC_AUTH_PASSWORD=cambia_esta_password
N8N_PUBLIC_URL=https://n8n-chatbot.shares.zrok.io/

# ── Frontend ──────────────────────────────────────────────
# Vacío ("") usa el mismo origen vía proxy Vite (/api) o Nginx en producción.
VITE_API_URL=
