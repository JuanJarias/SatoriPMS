# ═══════════════════════════════════════════════════════
# SatoriPMS — Variables de entorno
# Copia este archivo como .env y completa los valores
# NUNCA subas el .env al repositorio (está en .gitignore)
# ═══════════════════════════════════════════════════════

# ── Base de datos ────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://satori:satori_dev@localhost:5432/satoripms
POSTGRES_USER=satori
POSTGRES_PASSWORD=satori_dev
POSTGRES_DB=satoripms

# ── Backend (FastAPI) ────────────────────────────────────
PORT=8080
JWT_SECRET=cambia_esto_por_un_secreto_seguro_de_al_menos_32_caracteres
JWT_EXPIRES_IN=8h

# ── WhatsApp / Meta ──────────────────────────────────────
META_APP_ID=tu_app_id_de_meta
META_APP_SECRET=tu_app_secret_de_meta

WHATSAPP_TEST_PHONE=tu_numero_de_telefono_de_prueba
WHATSAPP_TOKEN=tu_token_de_la_cloud_api_de_meta
WHATSAPP_PHONE_ID=tu_phone_number_id
WHATSAPP_ACCOUNT_ID=tu_account_id_de_meta
WHATSAPP_VERIFY_TOKEN=tu_webhook_verify_token_de_meta
WHATSAPP_GRAPH_VERSION=v25.0

# ── Interpretación asistida ──────────────────────────────
GEMINI_API_KEY=tu_api_key_de_gemini

# ── Pasarela de pago (Puerto abstracto: sandbox | wompi) ─
PAYMENT_PROVIDER=sandbox
PAYMENT_WEBHOOK_SECRET=tu_secreto_para_firma_hmac_sha256
WOMPI_ENVIRONMENT=sandbox
WOMPI_PUBLIC_KEY=pub_test_de_wompi
WOMPI_PRIVATE_KEY=prv_test_de_wompi
WOMPI_EVENTS_SECRET=test_events_de_wompi
WOMPI_INTEGRITY_SECRET=test_integrity_de_wompi
BOOKING_TEST_PAYMENT_ENABLED=false

# ── Seguridad interna n8n ↔ FastAPI ──────────────────────
N8N_INTERNAL_API_KEY=cambia_esto_por_clave_interna_n8n_segura
N8N_EXPIRED_WEBHOOK_URL=

# ── Google Places & Reviews ──────────────────────────────
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=ChIJQRr4FV2zOY4RvqM_8_EfzsY
GOOGLE_REVIEWS_URL=https://www.google.com/travel/hotels/entity/CgsIvsf-mZ_-h-fGARAB/reviews

# ── Observabilidad (opcional en dev) ─────────────────────
SENTRY_DSN=

# ── n8n ──────────────────────────────────────────────────
# Incluye "n8n" para levantar el servicio; déjalo vacío para omitirlo.
COMPOSE_PROFILES=n8n
N8N_BASIC_AUTH_USER=SatoriPMS
N8N_BASIC_AUTH_PASSWORD=cambia_esta_password
N8N_PUBLIC_URL=https://n8n-chatbot.share.zrok.io/

# ── Frontend ──────────────────────────────────────────────
VITE_API_URL=http://localhost:8080
